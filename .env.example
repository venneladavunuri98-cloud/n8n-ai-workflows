# Copy to .env (never commit .env). Then add these as n8n Variables
# (Settings → Variables) or environment variables on your n8n host.

# 01 Restaurant voice agent
GENERAL_SUPPORT_PHONE_NUMBER=+10000000000

# 03 Outbound sales caller
OMNIDIM_AGENT_ID=

# 04 Prior authorization
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
BILLING_STAFF_EMAIL=
CARE_TEAM_EMAIL=
PHYSICIAN_EMAIL=

# API keys (OpenAI, Gemini, SerpApi, Google OAuth, Postgres, SMTP) go in
# n8n's Credentials screen, NOT in this file or in the workflow JSON.
