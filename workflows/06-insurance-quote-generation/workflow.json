    {
      "parameters": {
        "jsCode": "let plans = '';\n\nitems.forEach((item) => {\n\n  plans += `\n${item.json.rank}. ${item.json.company} - ${item.json.plan}\n\nPremium: ₹${item.json.premium}\n\nBodily Injury:\n${item.json.bodily_injury}\n\nCollision:\n${item.json.collision}\n\nComprehensive:\n${item.json.comprehensive}\n\nScore:\n${item.json.score}\n\n--------------------------------\n`;\n\n});\n\nreturn [\n  {\n    json: {\n\n      customer: items[0].json.customer,\n\n      email: items[0].json.email,\n\n      plans\n\n    },\n\n    pairedItem: {\n      item: 0\n    }\n\n  }\n];"
      },
