      "parameters": {
        "jsCode": "const response = String($json.output || \"\").trim();\n\nlet hasError = false;\nlet errorReason = \"\";\n\nlet parsed;\n\ntry {\n\n  // Remove markdown\n  const cleaned = response\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  parsed = JSON.parse(cleaned);\n\n  // ONLY use hasError from AI response\n  hasError = parsed.hasError === true;\n\n  // Extract errors\n  if (hasError) {\n\n    if (Array.isArray(parsed.errors)) {\n\n      errorReason = parsed.errors.join(\", \");\n\n    } else if (\n      parsed.errors &&\n      typeof parsed.errors === \"object\"\n    ) {\n\n      errorReason = Object.values(parsed.errors).join(\", \");\n\n    } else {\n\n      errorReason = \"Validation failed\";\n    }\n  }\n\n} catch (e) {\n\n  hasError = true;\n\n  errorReason = \"Invalid JSON response\";\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      hasError,\n      errorReason,\n      parsedResponse: parsed || null\n    }\n  }\n];"
      },
