      "id": "997cf589-12fe-4e96-8664-e41da57f9731",
      "name": "Prepare Plans1"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const customer =\n    item.json.parsedResponse?.normalized_data || {};\n\n  const budget =\n    Number(customer.budget || 0);\n\n  const premium =\n    Number(item.json.premium || 0);\n\n  const required =\n    customer.required_coverages || [];\n\n  let score = 0;\n\n  // Reject expensive plans\n  if (premium > budget) {\n\n    item.json.score = -1;\n\n    return item;\n  }\n\n  // Coverage scoring\n  required.forEach(cov => {\n\n    if (cov === \"BI_per_person\") {\n      score +=\n        Number(item.json.BI_per_person || 0) / 1000;\n    }\n\n    if (cov === \"BI_per_accident\") {\n      score +=\n        Number(item.json.BI_per_accident || 0) / 2000;\n    }\n\n    if (cov === \"collision_coverage\") {\n      score +=\n        Number(item.json.collision_coverage || 0) / 10000;\n    }\n\n    if (cov === \"comp_coverage\") {\n      score +=\n        Number(item.json.comp_coverage || 0) / 10000;\n    }\n\n    // Lower deductible is better\n    if (cov === \"collision_deductible\") {\n      score +=\n        5000 / Number(item.json.collision_deductible || 5000);\n    }\n\n    if (cov === \"comp_deductible\") {\n      score +=\n        5000 / Number(item.json.comp_deductible || 5000);\n    }\n\n  });\n\n  // Budget bonus\n  score += ((budget - premium) / budget) * 20;\n\n  item.json.score =\n    Number(score.toFixed(2));\n\n  item.json.customer =\n    customer.first_name || \"Customer\";\n\n  item.json.email =\n    customer.email || \"\";\n\n  return item;\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3184,
        1056
      ],
      "id": "65b1d1ff-271e-48a5-8174-4385f8357258",
      "name": "Score Plans1"
