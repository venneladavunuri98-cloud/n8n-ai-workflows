    {
      "parameters": {
        "jsCode": "items = items.filter(item => item.json.score >= 0);\n\nitems.sort((a, b) => b.json.score - a.json.score);\n\nconst top3 = items.slice(0, 3);\n\nreturn top3.map((item, index) => {\n\n  return {\n    json: {\n\n      rank: index + 1,\n\n      customer: item.json.customer,\n\n      email: item.json.email,\n\n      company: item.json.company,\n\n      plan: item.json.plan,\n\n      premium: item.json.premium,\n\n      bodily_injury:\n        `${item.json.BI_per_person}/${item.json.BI_per_accident}`,\n\n      collision:\n        `${item.json.collision_coverage}/${item.json.collision_deductible}`,\n\n      comprehensive:\n        `${item.json.comp_coverage}/${item.json.comp_deductible}`,\n\n      score:\n        item.json.score\n    }\n  };\n\n});"
      },
