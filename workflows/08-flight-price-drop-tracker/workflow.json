{
  "name": "Flight Price Drop Tracker",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\nconst origin = (item['Origin '] || item.Origin || '').toString().trim().toUpperCase();\nconst destination = (item.Destination || '').toString().trim().toUpperCase();\nconst departureDate = item['Departure Date'];\nconst returnDate = item['Return Date'] || '';\nconst expectedPrice = parseFloat(item['expected price']);\nconst alertEmail = item['Alert email'];\n\nreturn {\n  json: {\n    origin,\n    destination,\n    departureDate,\n    returnDate,\n    tripType: returnDate ? 1 : 2, // 1 = round trip, 2 = one way (SerpApi Google Flights convention)\n    expectedPrice,\n    alertEmail,\n    rowNumber: item.row_number\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        1040
      ],
      "id": "e56eabb9-a077-49ef-b44e-9a9c9bed199c",
      "name": "Prepare Search Params"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst prep = $('Prepare Search Params').item.json;\n\nconst flights = [\n  ...(response.best_flights || []),\n  ...(response.other_flights || [])\n];\n\nlet lowestPrice = null;\nfor (const f of flights) {\n  if (f.price != null && (lowestPrice === null || f.price < lowestPrice)) {\n    lowestPrice = f.price;\n  }\n}\n\nreturn {\n  json: {\n    ...prep,\n    currentPrice: lowestPrice\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
